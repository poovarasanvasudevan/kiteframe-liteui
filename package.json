{
  "name": "@kiteapps/lite-ui",
  "version": "0.1.0",
  "description": "Reusable React components for compact administration dashboards, reports, and settings.",
  "keywords": [
    "react",
    "ui-components",
    "dashboard",
    "storybook",
    "admin"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/lib/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./pages": {
      "types": "./dist/types/pages/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./pages/styles.css": "./dist/index.css"
  },
  "typesVersions": {
    "*": {
      "pages": [
        "dist/types/pages/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "lucide-react": ">=0.468.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "^7.90.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run build:lib",
    "build:demo": "react-scripts build",
    "build:lib": "node scripts/build-library.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "react-scripts test",
    "prepack": "npm run build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@hookform/resolvers": "4.1.3",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/preset-create-react-app": "^9.1.21",
    "@storybook/react-webpack5": "^9.1.21",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^18.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.90.0",
    "react-scripts": "5.0.1",
    "storybook": "^9.1.21",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zod": "3.24.4"
  }
}
