{
  "name": "@kiteapps/lite-ui",
  "version": "0.1.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "style": "./dist/index.css",
  "exports": {
    ".": { "import": "./dist/index.mjs", "require": "./dist/index.cjs" },
    "./pages": { "import": "./dist/pages.mjs", "require": "./dist/pages.cjs" },
    "./styles.css": "./dist/index.css",
    "./pages/styles.css": "./dist/pages.css"
  },
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.468.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:lib": "node scripts/build-library.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "react-scripts test",
    "prepack": "npm run build:lib",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/preset-create-react-app": "^9.1.21",
    "@storybook/react-webpack5": "^9.1.21",
    "esbuild": "^0.25.0",
    "storybook": "^9.1.21"
  }
}
